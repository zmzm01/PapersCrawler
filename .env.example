# PapersCrawler 密钥配置
# 复制此文件为 .env，填写真实值后保存
# .env 已加入 .gitignore，不会被提交

# CrossRef API 礼貌邮箱（必填）
CROSSREF_MAILTO=your_email@example.com

# Optional OpenAlex API key (singleton DOI lookups also work without one)
OPENALEX_API_KEY=

# MinerU PDF 解析 Token（从 https://mineru.net 获取）
MINERU_TOKEN=your_mineru_token_here

# LLM Provider 密钥；地址和模型在 configs/settings.yaml 配置。
LLM_API_KEY=your-command-code-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# 可选：覆盖运行日志目录；pytest 会自动使用临时目录，无需手工设置
# PAPERSCRAWLER_LOG_DIR=/tmp/paperscrawler-logs

# 旧版兼容变量（仅在未配置 llm.providers 时使用）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_LIST=https://api.deepseek.com/models
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# === Cloudflare Pages Direct Upload（可选）===
# deploy_report_site.py 会自动从本文件读取；不要手动 export，也不要提交真实值。
# Token 仅授予目标账户的 Cloudflare Pages 编辑权限。
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# CLOUDFLARE_PAGES_PROJECT=paperscrawler-reports

# === ntfy 最终运行汇总（可选；每次运行最多发送一条）===
# 自建 ntfy 服务可填写内部地址；不要把 topic/token 放进 settings.yaml
# NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOPIC=your_private_topic
# NTFY_TOKEN=tk_your_access_token

# === SMTP 邮件推送（可选，不配置则跳过 Phase H）===
# SMTP 服务器地址
# SMTP_HOST=smtp.163.com
# SMTP 端口: TLS=587, SSL=465
# SMTP_PORT=465
# use_tls=false 表示 SSL 直连（端口 465）；true 表示 STARTTLS（端口 587）
# SMTP_USE_TLS=false
# SMTP 登录用户名（通常是邮箱地址）
# SMTP_USERNAME=your_email@example.com
# SMTP 授权码（非邮箱登录密码！）
# SMTP_PASSWORD=your_auth_code
# 发件人地址
# SMTP_FROM_ADDR=your_email@example.com
# 收件人地址列表（多个用逗号分隔）
# SMTP_TO_ADDRS=colleague1@example.com,colleague2@example.com
