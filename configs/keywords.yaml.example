# =============================================================================
# 研究领域定义（示例模板）
# =============================================================================
# 将本文件复制为 keywords.yaml 并填写实际内容后使用。
# scope_definition: Phase E LLM prompt 使用的完整领域定义（中文）
# =============================================================================

core_anchors:
- 激光驱动离子/质子加速及后加速
- 激光靶相互作用与直接诊断
- 激光驱动粒子的紧凑输运、聚焦及实验束线
- 束流辐照效应与明确下游应用（材料、辐射生物、成像等）

# Literal terms are maintained separately from the natural-language topics.
# They support coverage audits and evidence extraction; a hit alone is not a
# relevance decision.  Every entry should point to one or more scope keys.
keyword_catalog:
  - id: plasma_lens_and_focusing
    terms: [plasma lens, active plasma lens, active plasma focusing]
    subdomains: [high_gradient_beam_transport]
    note: 等离子体透镜和主动等离子体聚焦
  - id: capillary_plasma_channel
    terms: [discharged capillary, capillary discharge, plasma channel]
    subdomains: [plasma_waveguide_and_channel]
    note: 放电毛细管与等离子体通道
  - id: bunch_plasma_wakefield
    terms: [bunch plasma wakefield, beam-plasma wakefield]
    subdomains: [high_gradient_beam_transport]
    note: 仅在束流传输、通道耦合或诊断语境中纳入
  - id: ablation_plasma_diagnostics
    terms: [烧蚀等离子体诊断, ablation plasma diagnostics]
    subdomains: [laser_plasma_physics_and_diagnostics]
  - id: capillary_diagnostics
    terms: [毛细管诊断, 等离子体通道诊断, plasma channel diagnostics]
    subdomains: [plasma_waveguide_and_channel, laser_plasma_physics_and_diagnostics]
  - id: flash_hydrodynamics
    terms: [FLASH流体动力学程序, FLASH hydrodynamics]
    subdomains: [laser_plasma_physics_and_diagnostics]
  - id: scintillator_detectors
    terms: [闪烁体探测器, 塑料闪烁体, scintillator detector, plastic scintillator]
    subdomains: [beam_irradiation_and_applications]
  - id: beam_optics_and_diagnostics
    terms: [可变形镜, 库仑力, 发射度, 电光晶体, deformable mirror, Coulomb force, emittance, electro-optic crystal]
    subdomains: [high_gradient_beam_transport]
  - id: acceleration_simulation_and_fields
    terms: [EMP, electromagnetic pulse, post-acceleration, PIC simulation]
    subdomains: [laser_driven_ion_acceleration, laser_plasma_physics_and_diagnostics]

scope_definition:
  laser_driven_ion_acceleration:
    display_name: 激光驱动离子/质子加速
    role: core
    a_requirements: [主贡献研究激光驱动离子或质子产生、加速或后加速]
    adjacent_examples: []
    exclusions: [普通同步环/对撞机加速器]
    description: '研究方向: laser_driven_ion_acceleration — 请替换为实际的中文描述'
    topics:
    - Topic 1 — 说明1
    - Topic 2 — 说明2
  laser_plasma_physics_and_diagnostics:
    display_name: 激光等离子体物理与直接诊断
    role: core
    a_requirements: [明确研究激光靶相互作用、预等离子体或服务该体系的诊断]
    adjacent_examples: []
    exclusions: [与激光驱动粒子无关的通用等离子体]
    description: '研究方向: laser_plasma_physics_and_diagnostics — 请替换为实际的中文描述'
    topics:
    - Topic 1 — 说明1
    - Topic 2 — 说明2
  high_gradient_beam_transport:
    display_name: 高梯度束流传输与后加速
    role: core
    a_requirements: [明确服务激光驱动粒子的紧凑传输、聚焦或后加速]
    adjacent_examples: [具体束线磁光学方法可迁移到激光驱动粒子束]
    exclusions: [仅讨论传统加速器束线]
    description: '研究方向: high_gradient_beam_transport — 请替换为实际的中文描述'
    topics:
    - Topic 1 — 说明1
    - Topic 2 — 说明2
  plasma_waveguide_and_channel:
    display_name: 等离子体波导与通道
    role: core
    a_requirements: [主贡献研究等离子体波导/通道的形成、演化、稳定性或诊断表征；纯电子 LWFA 只是应用背景时仍可判 A]
    adjacent_examples: [具体可迁移的波导、通道形成或表征方法]
    exclusions: [仅研究纯电子加速且没有通道/波导贡献，或传统加速器独立通道]
    description: '研究方向: plasma_waveguide_and_channel — 请替换为实际的中文描述'
    topics:
    - Plasma waveguide/channel formation and characterization
    - Capillary discharge and laser-induced plasma channels
  beam_irradiation_and_applications:
    display_name: 束流辐照与应用
    role: core
    a_requirements: [主贡献研究粒子束辐照效应、剂量或损伤机制，或验证材料、辐射生物、成像等明确应用]
    adjacent_examples: [仅提供可迁移的辐照装置、剂量学或探测方法]
    exclusions: [只在背景或展望中泛泛提到潜在应用]
    description: '研究方向: beam_irradiation_and_applications — 请替换为实际的中文描述'
    topics:
    - Topic 1 — 说明1
    - Topic 2 — 说明2
  accelerator_control_automation_and_ai:
    display_name: 加速器控制、自动化与 AI
    role: supporting
    a_requirements: []
    adjacent_examples: [论文实际展示对激光驱动紧凑束线的控制迁移]
    exclusions: [仅在同步环/对撞机上验证的 AI]
    description: '研究方向: accelerator_control_automation_and_ai — 请替换为实际的中文描述'
    topics:
    - Topic 1 — 说明1
    - Topic 2 — 说明2
irrelevant_fields:
  description: 定义哪些领域即使出现相关关键词也应视为不相关
  topics:
  - '领域1: 说明1'
  - '领域2: 说明2'
