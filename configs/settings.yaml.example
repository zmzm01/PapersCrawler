# =============================================================================
# PapersCrawler 运行参数配置
# =============================================================================
# 此文件用于配置流水线的运行参数。
# 修改后重启流水线或 WebUI 即可生效。
# 敏感信息（API 密钥、SMTP 密码）请放在 .env 中，不要放在这里。
# =============================================================================

# ---------------------------------------------------------------------------
# 阶段开关 (true = 跳过该阶段)
# ---------------------------------------------------------------------------
skip_phases:
  A_RSS: false       # RSS 发现路径
  A_CR: false        # CrossRef 发现路径
  B: false           # CrossRef 元数据补全
  C: false           # Publisher 页面爬取
  E: false           # LLM 相关性判断
  E2: false          # MinerU PDF 解析
  E3: false          # 正文相关性终审
  F: false           # LLM 论文总结
  G: true           # 报告生成
  H: true           # 邮件推送

# ---------------------------------------------------------------------------
# ntfy 最终运行汇总（面向 Web App 的 Markdown；不发送开始/逐阶段/即时错误通知）
# ---------------------------------------------------------------------------
ntfy:
  enabled: false
  timeout_seconds: 10
  title: "PapersCrawler 运行汇总"
  priority: default

# ---------------------------------------------------------------------------
# LLM API 配置
# ---------------------------------------------------------------------------
llm:
  # 推荐在 .env 的 LLM_BASE_URL 中配置服务地址；可填写 /v1 基础地址
  # 或完整 /chat/completions endpoint。未设置时才使用代码内置回退。

  # 相关性判断（Phase E）— 高频初筛，使用低成本快速模型
  relevance:
    protocol: openai_chat
    model: Qwen/Qwen3.7-Flash
    thinking: disabled
    timeout: 300

  # 可选的 E→E3 相关/非相关跨边界复核；仅在列出的变化发生时调用第二模型。
  relevance_escalation:
    enabled: false
    protocol: openai_chat
    model: deepseek/deepseek-v4-pro
    thinking: enabled
    timeout: 300
    transitions:
      - A->C
      - A->D
      - B->C
      - B->D
      - C->A
      - C->B
      - D->A
      - D->B

  # 论文总结（Phase F）— 中文结构化总结，兼顾质量与成本
  summary:
    # Responses API 示例；如果网关提供 Responses 协议，可切换该角色。
    # protocol: openai_responses
    # model: meta/muse-spark-1.2-contributor
    protocol: openai_chat
    model: MiniMaxAI/MiniMax-M3
    thinking: disabled
    timeout: 300

  # 正文相关性终审（Phase E3）— 模型应以人工 benchmark 结果选择
  fulltext_relevance:
    protocol: openai_chat
    model: Qwen/Qwen3.7-Flash
    thinking: enabled
    timeout: 300
    evidence_max_chars: 200000

  # 并发上限：Phase E/F 同时发起的 LLM 请求数
  concurrent_max: 100

fulltext_download:
  daily_max: 3
  publisher_daily_max: 2
  delay_min_seconds: 30
  delay_max_seconds: 90

openalex:
  enabled: true
  # Optional; prefer OPENALEX_API_KEY in .env.
  api_key: ""
  max_concurrency: 4
  requests_per_second: 8
  timeout_seconds: 30
  max_attempts: 3
  backoff_max_seconds: 30

# ---------------------------------------------------------------------------
# 流水线运行参数
# ---------------------------------------------------------------------------
pipeline:
  # Phase A CrossRef 发现: 回溯天数（每日增量模式取今天往前 N 天）
  crossref_lookback_days: 1

  # Phase A CrossRef 智能回溯硬上限（故障补漏时实际回溯不超过此值）
  # 实际回溯 = min(crossref_lookback_days, today - last_successful_run)
  # 故障超过此值仍会漏检（与正常 1 天轮询语义不同）
  crossref_lookback_days_max: 7

  # 每阶段最多处理 N 篇论文 (0 = 不限制)
  max_papers_per_phase: 0

  # 过滤 Nature 新闻 (d41586 DOI)，只保留研究论文
  skip_nature_news: true

# ---------------------------------------------------------------------------
# Source access 参数（访问出版商及其他论文来源站点的策略）
# ---------------------------------------------------------------------------
source_access:
  # 同来源内页面间随机延迟范围 (秒)
  page_delay_min: 3
  page_delay_max: 5

  # 已有有效 CrossRef 摘要时跳过出版商页面抓取
  skip_if_crossref_abstract: true

  # 同一来源连续抓取失败 N 篇后自动中止该来源
  max_consecutive_failures: 3

  # 来源专属主访问路由（key 为来源/出版商标识）。Phase C 与 E2 的
  # 文章页访问、PDF 下载均复用。
  routes:
    optica:
      server: "http://proxy.example.com:8080"

  # 所有常规重试失败后，使用该代理新建浏览器上下文再尝试一次。
  # 留空表示关闭；仅在 Phase C 常规重试耗尽后作为末级 fallback。
  fallback_proxy_url: ""

  # Bot Manager/验证码失败的自动重试策略；达到次数后隔离，日常任务不再重试。
  # 需要人工验证时使用 tools/run_pipeline.py --retry-bot-blocks。
  bot_retry_cooldown_hours: 72
  bot_max_retries: 3

# ---------------------------------------------------------------------------
# FormulaFixer 公式修复
# ---------------------------------------------------------------------------
formula_fix:
  # true = 跳过修复，false = 启用（对 json.loads 后的纯文本做二次公式包裹修正）
  skip: false
  # true = 跳过 needs_fix() 检测，所有字段强制送修
  force: false
  # FormulaFixer 独立并发上限，不占用 Phase E/F 的总结并发池
  concurrent_max: 10
  # 每个字段最多执行几轮「KaTeX 校验 → LLM 修复 → KaTeX 验收」
  max_repair_rounds: 1
  llm:
    protocol: openai_chat
    model: Qwen/Qwen3.7-Flash
    thinking: disabled
    max_tokens: 4096
    timeout: 120
