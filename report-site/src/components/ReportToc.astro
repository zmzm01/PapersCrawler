---
import { contentItems, contentText, type PublicReport } from '../lib/reports';

interface Props { report: PublicReport; }
const { report } = Astro.props;
const papers = contentItems(report.content, 'papers');
---

<aside class="report-toc" aria-label="论文目录">
	<p class="toc-kicker">PAPER INDEX</p>
	<h2>论文目录</h2>
	<nav class="toc-links">
		{papers.map((paper, index) => {
			const title = contentText(paper, 'title') || '未命名论文';
			const category = contentText(paper, 'relevanceCategory') || '—';
			return <a href={`#paper-${index + 1}`} title={title} data-paper-link={`paper-${index + 1}`}><b>{index + 1}</b><i>{category}</i><span>{title}</span></a>;
		})}
	</nav>
	<details class="mobile-paper-index">
		<summary>论文目录 · {papers.length}</summary>
		<nav aria-label="移动端论文目录">
			{papers.map((paper, index) => {
				const title = contentText(paper, 'title') || '未命名论文';
				return <a href={`#paper-${index + 1}`}><span>{index + 1}. {title}</span></a>;
			})}
		</nav>
	</details>
</aside>

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-paper-link]')];
	const papers = links
		.map((link) => document.getElementById(link.dataset.paperLink || ''))
		.filter((paper): paper is HTMLElement => Boolean(paper));
	if ('IntersectionObserver' in window && papers.length > 0) {
		const visible = new Map<string, number>();
		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) visible.set(entry.target.id, entry.boundingClientRect.top);
				else visible.delete(entry.target.id);
			}
			const current = [...visible.entries()].sort((left, right) => Math.abs(left[1]) - Math.abs(right[1]))[0]?.[0];
			for (const link of links) link.toggleAttribute('aria-current', link.dataset.paperLink === current);
		}, { rootMargin: '-18% 0px -62% 0px' });
		for (const paper of papers) observer.observe(paper);
	}
</script>
