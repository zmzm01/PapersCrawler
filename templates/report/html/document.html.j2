{# ==========================================================================
   templates/report/html/document.html.j2
   --------------------------------------------------------------------------
   完整 HTML 文档：DOCTYPE + head（含 CSS）+ body（legend + papers）。

   context 变量：
     - papers (list[dict]): 论文字典列表
     - full_document (bool): 是否输出完整 HTML 文档
     - style_css (str): 内联 CSS 内容（来自 html/style.css）
   ========================================================================== #}
{% import "html/paper.html.j2" as paper_tmpl %}
{% import "html/legend.html.j2" as legend_tmpl %}
{% import "html/sort_note.html.j2" as sort_note_tmpl %}
{% import "html/disclaimers.html.j2" as disclaimers_tmpl -%}
{% if full_document -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>文献报告</title>
  <style>
{{ style_css }}
  </style>
</head>
<body>
  <h1>文献报告</h1>
{{ sort_note_tmpl.sort_note() }}
{{ legend_tmpl.legend() }}
{{ disclaimers_tmpl.disclaimers() }}
{% if papers|length > 0 -%}
{% set core_papers = papers|selectattr('relevance_category', 'equalto', 'A')|list -%}
{% set watch_papers = papers|selectattr('relevance_category', 'equalto', 'B')|list -%}
  <section class="decision-summary">
    <p><strong>本期决策摘要：</strong>核心推荐（A）{{ core_papers|length }} 篇；邻近观察（B）{{ watch_papers|length }} 篇。</p>
    <p><strong>核心推荐（A）</strong></p>
    <ul>{% for p in core_papers %}<li><strong>{{ p.title }}</strong>{% if p.matched_subdomains_labels %} · {{ p.matched_subdomains_labels|join('、') }}{% endif %} · {{ p.relevance_basis }} — {{ p.one_sentence or p.relevance_reason }}{% if p.page_url %} <a href="{{ p.page_url }}">原文</a>{% endif %}</li>{% else %}<li>无</li>{% endfor %}</ul>
    <p><strong>邻近观察（B，全部保留）</strong></p>
    <ul>{% for p in watch_papers %}<li><strong>{{ p.title }}</strong>{% if p.matched_subdomains_labels %} · {{ p.matched_subdomains_labels|join('、') }}{% endif %} · {{ p.relevance_basis }} — {{ p.one_sentence or p.relevance_reason }}{% if p.page_url %} <a href="{{ p.page_url }}">原文</a>{% endif %}</li>{% else %}<li>无</li>{% endfor %}</ul>
  </section>
{% endif -%}
{% for p in papers %}{{ paper_tmpl.paper(p) }}
{% endfor %}
</body>
</html>
{%- else -%}
{{ sort_note_tmpl.sort_note() }}
{{ legend_tmpl.legend() }}
{{ disclaimers_tmpl.disclaimers() }}
{% if papers|length > 0 -%}
{% set core_papers = papers|selectattr('relevance_category', 'equalto', 'A')|list -%}
{% set watch_papers = papers|selectattr('relevance_category', 'equalto', 'B')|list -%}
  <section class="decision-summary">
    <p><strong>本期决策摘要：</strong>核心推荐（A）{{ core_papers|length }} 篇；邻近观察（B）{{ watch_papers|length }} 篇。</p>
    <p><strong>核心推荐（A）</strong></p>
    <ul>{% for p in core_papers %}<li><strong>{{ p.title }}</strong>{% if p.matched_subdomains_labels %} · {{ p.matched_subdomains_labels|join('、') }}{% endif %} · {{ p.relevance_basis }} — {{ p.one_sentence or p.relevance_reason }}{% if p.page_url %} <a href="{{ p.page_url }}">原文</a>{% endif %}</li>{% else %}<li>无</li>{% endfor %}</ul>
    <p><strong>邻近观察（B，全部保留）</strong></p>
    <ul>{% for p in watch_papers %}<li><strong>{{ p.title }}</strong>{% if p.matched_subdomains_labels %} · {{ p.matched_subdomains_labels|join('、') }}{% endif %} · {{ p.relevance_basis }} — {{ p.one_sentence or p.relevance_reason }}{% if p.page_url %} <a href="{{ p.page_url }}">原文</a>{% endif %}</li>{% else %}<li>无</li>{% endfor %}</ul>
  </section>
{% endif -%}
{% for p in papers %}{{ paper_tmpl.paper(p) }}
{% endfor %}
{%- endif %}
