{# ==========================================================================
   templates/report/html/legend.html.j2
   --------------------------------------------------------------------------
   报告头部的「相关性等级说明」图例（HTML blockquote 形式）。

   视觉样式由 html/style.css 中的 blockquote.relevance-legend 块控制。
   ========================================================================== #}
{% macro legend(presentation=None) -%}
{% set presentation = presentation or build_report_presentation() -%}
  <blockquote class="relevance-legend">
    <p><strong>相关性等级说明</strong></p>
    <ul>
{% for item in presentation.relevanceLegend %}      <li><strong>{{ item.code }}</strong>（{{ item.name }}）：{{ item.description }}</li>
{% endfor %}
    </ul>
  </blockquote>
{%- endmacro %}
